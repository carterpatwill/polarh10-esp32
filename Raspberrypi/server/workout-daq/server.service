[Unit]
Description=Polar H10 server (ESP32 → MQTT → SQLite) for the Pi
After=network.target

[Service]
Type=simple
User=__USER__
# WorkingDirectory is the server/ parent so hr_data.db + the shared .venv resolve.
WorkingDirectory=__ROOT__
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=__ROOT__/workout-daq/mqtt.env
ExecStart=__ROOT__/.venv/bin/python3 __ROOT__/workout-daq/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

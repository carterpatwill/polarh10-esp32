[Unit]
Description=Morning HRV baseline capture (Polar H10 → BLE → SQLite) for the Pi
After=network.target bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=__USER__
# WorkingDirectory is the server/ parent so hr_data.db + the shared .venv resolve.
WorkingDirectory=__ROOT__
Environment=PYTHONUNBUFFERED=1
ExecStart=__ROOT__/.venv/bin/python3 __ROOT__/morning-hrv/morning_hrv.py watch
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target

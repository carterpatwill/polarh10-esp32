#pragma once

// Copy this file to `config.h` and fill in your own values.
// `config.h` is gitignored so your credentials never get committed.
//
// This is the BLE-only local-logging build: the board records HR + ACC from the
// Polar strap to onboard flash and never uses WiFi while recording. WiFi only
// comes up in "sync mode" (when you plug the board into a computer over USB) to
// serve the stored session files over a small web page on your LAN.

// ── WiFi — used ONLY in sync mode to offload recordings ──────────────────────
// When you plug the board into USB it joins this network, prints its URL to the
// serial monitor, and serves the recorded sessions. Two networks are tried in
// order so you can offload at home or somewhere else.
#define SYNC_SSID       "YOUR_WIFI_SSID"
#define SYNC_PASS       "YOUR_WIFI_PASSWORD"
#define SYNC_SSID2      "YOUR_SECOND_WIFI_SSID"
#define SYNC_PASS2      "YOUR_SECOND_WIFI_PASSWORD"

// ── Board pins — Seeed Studio XIAO ESP32-S3 ──────────────────────────────────
// Onboard user LED is GPIO21 and is ACTIVE-LOW (driving LOW lights it):
//   solid on    → strap connected, a session is recording
//   slow blink  → scanning / no strap yet
//   fast blink  → sync mode (USB plugged in, serving files over WiFi)
//   rapid triple-blink → flash is full, recording stopped (plug in and offload)
#define PIN_STATUS_LED  21

// The XIAO has no peripheral power-enable pin (the T-Display-S3 used GPIO15).
// Leave as -1 to skip. Set to a GPIO if your carrier board needs one driven high.
#define PIN_POWER_ON    -1

// ── Battery ───────────────────────────────────────────────────────────────────
// The XIAO ESP32-S3 does NOT route battery voltage to an ADC by default, so to
// read battery level you must wire BAT+ through a 1:2 divider (e.g. two equal
// resistors like 220k/220k) into one of the analog pins, then set PIN_BAT_ADC
// to that GPIO. Analog-capable pins:
//   A0=GPIO1  A1=GPIO2  A2=GPIO3  A3=GPIO4  A4=GPIO5  A5=GPIO6
//   A8=GPIO7  A9=GPIO8  A10=GPIO9
// Set PIN_BAT_ADC to -1 to disable battery reading (status reports -1 = unknown).
#define PIN_BAT_ADC  2    // A1 / D1 on XIAO — change to match your divider wiring

// ── Tuning ───────────────────────────────────────────────────────────────────
#define BATCH_MS   10000   // HR flush-to-flash interval (ms)
#define QUEUE_LEN  120     // max HR readings buffered before drop

// A brief strap dropout within this window keeps writing to the SAME session
// file when it reconnects; a longer gap finalizes the session and the next
// connect starts a new one.
#define SESSION_RESUME_MS  60000   // 60 s

// Stop writing once free flash falls below this margin (bytes), so we never
// wedge the filesystem. The LED switches to the rapid triple-blink "full" state.
#define FLASH_MIN_FREE  65536      // 64 KB

// ── Accelerometer (Polar PMD service) ────────────────────────────────────────
#define ACC_SAMPLE_RATE  25      // Hz — must match the PMD start command below (25/50/100/200)
#define ACC_RANGE_G      8       // ±g full-scale
#define ACC_BATCH_MS     2000    // ACC flush-to-flash interval (ms); 25 Hz → ~50 samples/batch
#define QUEUE_LEN_ACC    256     // max ACC samples buffered before drop
